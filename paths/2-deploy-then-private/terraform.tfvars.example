# Required: throwaway password for the demo RDS instance.
db_password = "ChangeMe-demo-only-123!"

# The two-apply switch:
#   FIRST apply  — leave go_private = false (or omit). Deploys with NAT; app
#                  installs from PyPI; verify via DNS/HTTP.
#   SECOND apply — set go_private = true. Removes NAT/IGW, adds VPC endpoints;
#                  re-verify via Private VPC.
go_private = false

# Optional overrides:
# region         = "us-east-1"
# name_prefix    = "continuum-d2p-pentest"
# vpc_cidr       = "10.0.0.0/16"
# az_count       = 2
# private_domain = "internal.pentest-demo.local"
# app_hostname   = "app"
# instance_type  = "t3.small"


# Optional: set to true if you configure CloudWatch logging for the Agent Space.
# enable_cloudwatch_logs_endpoint = true