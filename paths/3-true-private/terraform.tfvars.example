# Required: throwaway password for the demo RDS instance.
db_password = "ChangeMe-demo-only-123!"

# BEFORE your first apply, vendor the Python wheels (needs internet on your
# machine — the VPC never gets any):
#   ./vendor-wheels.sh
# Then: terraform apply

# Optional overrides:
# region         = "us-east-1"
# name_prefix    = "continuum-tp-pentest"
# vpc_cidr       = "10.0.0.0/16"
# az_count       = 2
# private_domain = "internal.pentest-demo.local"
# app_hostname   = "app"
# instance_type  = "t3.small"

# Optional: set to true if you configure CloudWatch logging for the Agent Space.
# enable_cloudwatch_logs_endpoint = true